    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx-toolkit/core": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "express": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "concurrently": "^10.0.7",
    "heroicons": "^2.2.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
