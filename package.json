{
  "name": "folio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -s first -n api,ng -c yellow,cyan \"npm:api\" \"ng serve\"",
    "api": "node server/index.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:dist": "npm run build && node server/index.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
