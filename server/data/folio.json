      "title": "Lemon posset",
      "values": {
        "servings": 6,
        "prep_min": 10,
        "difficulty": "Easy",
        "ingredients": [
          "double cream",
          "caster sugar",
          "lemons"
        ],
        "method": "Boil cream and sugar exactly 3 minutes. Off heat, whisk in lemon juice. Pour, chill overnight. It sets like a small miracle."
      },
