      "collectionId": "894b5c2f-f911-43c3-9651-1b23f4c7ebac",
      "title": "Kingfisher, brief",
      "values": {
        "location": "Alder bend",
        "observed_on": "2026-10-27",
        "conditions": "Clear",
        "elevation_m": 66,
        "notes": "A blue spark along the water for maybe four seconds. Perched once, dropped, gone. The whole walk was worth it."
      },
      "tags": [
