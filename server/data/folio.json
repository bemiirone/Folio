      "collectionId": "39333551-515d-4288-ab67-cfcf88bd51d2",
      "title": "Miso butter mushrooms",
      "values": {
        "servings": 2,
        "prep_min": 15,
        "difficulty": "Easy",
        "ingredients": [
          "chestnut mushrooms",
          "white miso",
          "butter",
          "thyme",
          "sourdough"
        ],
        "method": "Dry-fry mushrooms until squeaky, then add butter and miso off the heat. Thyme at the end. Pile onto toast. Eat standing up."
      },
      "tags": [
        "quick",
        "vegetarian"
      ],
