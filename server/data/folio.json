      "id": "2d89bea3-0022-4f8a-a29e-42de7a577b3a",
      "collectionId": "39333551-515d-4288-ab67-cfcf88bd51d2",
      "title": "Weeknight ragù",
      "values": {
        "servings": 4,
        "prep_min": 45,
        "difficulty": "Medium",
        "ingredients": [
          "beef mince",
          "soffritto",
          "tomato paste",
          "red wine",
          "milk",
          "tagliatelle"
        ],
        "method": "Brown the mince hard in batches. Soften soffritto, add paste, deglaze with wine. Return meat, add milk, then barely simmer 40 minutes. Season late."
      },
      "tags": [
        "pasta",
        "batch-cook"
      ],
      "starred": true,
      "createdAt": "2026-11-24T11:51:06.995Z",
      "updatedAt": "2026-11-24T13:51:06.995Z"
