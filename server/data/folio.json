    {
      "id": "9eed4421-adc9-4004-ace4-7ef91b91d07f",
      "collectionId": "93d515bd-7d40-421d-b45b-1b1bdea5ef26",
      "title": "Heron at the millpond",
      "values": {
        "location": "Millpond, lower gate",
        "observed_on": "2026-11-14",
        "conditions": "Fog",
        "elevation_m": 84,
        "notes": "Grey heron stood motionless for eleven minutes, then struck twice — missed both. Fog lifted at 08:40 and it left upstream without a sound."
      },
      "tags": [
        "birds",
        "water",
        "dawn"
      ],
      "starred": true,
      "createdAt": "2026-11-25T10:51:06.995Z",
      "updatedAt": "2026-11-25T12:51:06.995Z"
    },
    {
      "id": "6960fb3c-cbe7-465b-b134-51aaeb357897",
      "collectionId": "93d515bd-7d40-421d-b45b-1b1bdea5ef26",
      "title": "First frost on the ridge",
      "values": {
        "location": "Cairn ridge path",
        "observed_on": "2026-11-09",
        "conditions": "Clear",
        "elevation_m": 412,
        "notes": "Every spiderweb between the gorse had become a white rope. Ground hard underfoot; the beck still running below the ice shelf."
      },
      "tags": [
        "frost",
        "ridge"
      ],
      "starred": false,
      "createdAt": "2026-11-20T13:51:06.995Z",
      "updatedAt": "2026-11-20T15:51:06.995Z"
    },
    {
      "id": "ae653ad9-76e8-4897-bc30-d53685fa725c",
      "collectionId": "93d515bd-7d40-421d-b45b-1b1bdea5ef26",
      "title": "Fox tracks by the weir",
      "values": {
        "location": "Weir pool, east bank",
        "observed_on": "2026-11-02",
        "conditions": "Overcast",
        "elevation_m": 71,
        "notes": "A neat line of prints in the silt, purposeful, heading for the bridge. Otter spraint on the far rock — worth a return visit."
      },
      "tags": [
        "mammals",
        "water"
      ],
      "starred": false,
      "createdAt": "2026-11-13T11:51:06.995Z",
      "updatedAt": "2026-11-13T13:51:06.995Z"
    },
    {
      "id": "fc69cf86-0aa9-451b-8584-7c2a18b7e294",
      "collectionId": "93d515bd-7d40-421d-b45b-1b1bdea5ef26",
      "title": "Kingfisher, brief",
      "values": {
        "location": "Alder bend",
        "observed_on": "2026-10-27",
        "conditions": "Clear",
        "elevation_m": 66,
        "notes": "A blue spark along the water for maybe four seconds. Perched once, dropped, gone. The whole walk was worth it."
      },
      "tags": [
        "birds",
        "water"
      ],
      "starred": true,
      "createdAt": "2026-11-07T15:51:06.995Z",
      "updatedAt": "2026-11-07T17:51:06.995Z"
    },
    {
      "id": "0b357761-3f41-4bd1-b7d8-cc2dba1e8fd3",
      "collectionId": "93d515bd-7d40-421d-b45b-1b1bdea5ef26",
      "title": "Storm light over the fell",
      "values": {
        "location": "South fell shoulder",
        "observed_on": "2026-10-19",
        "conditions": "Rain",
        "elevation_m": 505,
        "notes": "Squall line crossed the valley in curtains. For a minute the whole moor went brass-coloured under a black sky. Sheltered by the wall and just watched."
      },
      "tags": [
        "weather",
        "ridge"
      ],
      "starred": false,
      "createdAt": "2026-10-30T17:51:06.995Z",
      "updatedAt": "2026-10-30T19:51:06.995Z"
