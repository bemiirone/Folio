      "collectionId": "39333551-515d-4288-ab67-cfcf88bd51d2",
      "title": "Saturday soda bread",
      "values": {
        "servings": 8,
        "prep_min": 50,
        "difficulty": "Easy",
        "ingredients": [
          "flour",
          "buttermilk",
          "bicarb",
          "salt",
          "oats"
        ],
        "method": "Mix fast, handle barely, cross the top deeply. 40 minutes at 200°C. Wrap in a tea towel while it cools so the crust stays kind."
      },
