      "collectionId": "894b5c2f-f911-43c3-9651-1b23f4c7ebac",
      "title": "Fox tracks by the weir",
      "values": {
        "location": "Weir pool, east bank",
        "observed_on": "2026-11-02",
        "conditions": "Overcast",
        "elevation_m": 71,
        "notes": "A neat line of prints in the silt, purposeful, heading for the bridge. Otter spraint on the far rock — worth a return visit."
      },
      "tags": [
        "mammals",
        "water"
      ],
      "starred": false,
      "createdAt": "2026-11-13T06:19:34.143Z",
