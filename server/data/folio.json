      "collectionId": "24ef4639-a0ac-423a-af76-665be1b2aaa2",
      "title": "Weeknight ragù",
      "values": {
        "servings": 4,
        "prep_min": 45,
        "difficulty": "Medium",
        "ingredients": [
          "beef mince",
          "soffritto",
          "tomato paste",
          "red wine",
          "milk",
          "tagliatelle"
        ],
        "method": "Brown the mince hard in batches. Soften soffritto, add paste, deglaze with wine. Return meat, add milk, then barely simmer 40 minutes. Season late."
      },
      "tags": [
        "pasta",
        "batch-cook"
      ],
