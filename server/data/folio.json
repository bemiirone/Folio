      "id": "12b685db-2cb7-4ace-98a8-cc8e10869041",
      "collectionId": "894b5c2f-f911-43c3-9651-1b23f4c7ebac",
      "title": "Heron at the millpond",
      "values": {
        "location": "Millpond, lower gate",
        "observed_on": "2026-11-14",
        "conditions": "Fog",
        "elevation_m": 84,
        "notes": "Grey heron stood motionless for eleven minutes, then struck twice — missed both. Fog lifted at 08:40 and it left upstream without a sound."
      },
      "tags": [
        "birds",
        "water",
        "dawn"
      ],
      "starred": true,
      "createdAt": "2026-11-25T05:19:34.143Z",
      "updatedAt": "2026-11-25T07:19:34.143Z"
    },
    {
      "id": "9652b817-f56f-4653-a6a9-aad8feb3eeca",
      "collectionId": "894b5c2f-f911-43c3-9651-1b23f4c7ebac",
      "title": "First frost on the ridge",
      "values": {
        "location": "Cairn ridge path",
        "observed_on": "2026-11-09",
        "conditions": "Clear",
        "elevation_m": 412,
        "notes": "Every spiderweb between the gorse had become a white rope. Ground hard underfoot; the beck still running below the ice shelf."
      },
      "tags": [
        "frost",
        "ridge"
      ],
      "starred": false,
      "createdAt": "2026-11-20T08:19:34.143Z",
